 "notes": {
  "openmw.interfaces.<other>": "script interfaces resolve to nil unless another hosted script provides them",
  "remove": "R1: content refs disabled + tombstoned, created refs deleted",
  "teleport": "R2: limbo object placed on a tombstone of the same record is resurrected; else tes3.createReference",
  "moveInto": "R3: during activation, redirected to a vanilla pickup of the tombstoned original",
  "createRecord": "Light/any type with a template only; model >31 chars needs a packager mesh alias (R4)",
  "local scripts": "NPC/CREATURE/ACTOR/CONTAINER/DOOR/LIGHT/ACTIVATOR scripts, CUSTOM scripts added with addScript and PLAYER scripts run per object while it is in an active cell (the player always); onSave data and named timers are kept per object across cell changes and saves; unsavable timers restart with the chunk",
  "I.AI": "Combat via mobile:startCombat; Wander/Travel/Follow/Escort via tes3.setAI*; getActivePackage reads inCombat then aiPlanner",
  "openmw.nearby": "lists references in tes3.getActiveCells() (cached per frame); castRay and castRenderingRay use tes3.rayTest (rendered geometry: collisionType and radius are ignored); other queries are unsupported",
  "Enabled switch": "every converted mod's MCM tab starts with a 'Mod enabled' switch (default on, saved per mod in MWSE/config/omwcompat_<mod>.json). Off stops all its scripts, timers, events and handlers from the next frame and keeps its saved state; on restarts them from that state on the next frame (onLoad); no reload is needed; interfaces it registered stay registered; changes it made to the world are not undone",
  "CUSTOM": "addScript(path, initData) for CUSTOM scripts of converted mods only (not on Statics or items in an inventory); attachments are saved; the script starts on the next frame (onInit(initData)) if the object is active; removeScript drops it with its data; hasScript also sees type-flag and PLAYER scripts",
  "PLAYER": "hosted on tes3.player: openmw.self/nearby/ui/ambient/input; onFrame every frame (also paused); onKeyPress/onKeyRelease from MWSE keyDown/keyUp outside menus only; onQuestUpdate from the journal event",
  "openmw.ui": "showMessage only (tes3.messageBox); layouts, widgets, templates and HUD elements are unsupported",
  "openmw.ambient": "tes3.playSound without a reference; playSoundFile strips a leading sound/; stopSound/isSoundPlaying by id; say plays the file (no subtitle UI)",
  "openmw.input": "isKeyPressed/KEY via inputController:isKeyDown (KEY values are SDL scancodes mapped to DirectInput); actions, triggers, gamepad and mouse are unsupported",
  "core.sound": "playSound3d etc. via tes3.playSound/removeSound/getSoundPlaying on the reference; stopSay stops all sounds on the reference; isEnabled is always true",
  "core.factions": "records[id or index]: id, name, ranks (name, attributeValues, primarySkillValue, favouredSkillValue, factionReputation = factionReaction = MWSE reputation), reactions, attributes, skills; hidden is always false",
  "equipment": "getEquipment reads ref.object.equipment and puts items in OpenMW slots (bracers -> gauntlet slots, shield/light -> CarriedLeft, second ring -> RightRing); setEquipment needs an active actor (mobile:equip/unequip)",
  "stance": "getStance/setStance map to mobile.castReady/weaponReady",
  "stats.level": "current = record level (read-only), progress = player's levelUpProgress",
  "skills": "NPC.stats.skills.<id>: base/modified/modifier via getSkillStatistic and tes3.setStatistic{skill=}; damage is 0; progress for the player only",
  "self.controls": "sneak/run/jump read the actor's current state; other controls warn; writes raise",
  "quests": "Player.quests(p)[id]: stage get/set (journal index), started, finished (Finished flag of the current entry), addJournalEntry (tes3.updateJournal); iterating all quests is unsupported",
  "owner": "tes3.getOwner/setOwner: recordId (NPC) or factionId + factionRank (MWSE requiredRank)",
  "removed in OpenMW 0.51": "legacySymbols: async.newRealTimer, newUnsavableRealTimer, self.ownerRecordId, types.Actor/Item.record(s) and types.<Actor>.equipment are not in OpenMW 0.51's API; omwcompat still provides them for older mods and the scanner accepts them; api-audit does not list them",
  "sendEvent": "delivered next frame to the object's hosted local scripts (dropped when it has none and the event is not built in); built-in events ShowMessage (player), Unequip and PlaySound3d run after the mod's handlers"
 },
